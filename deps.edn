;; mailroom: named messages come in, a handler's steps answer them, the answers go out.
;; One tree for both languages: source-code/mailroom/, the server's .clj and the
;; browser's .cljs side by side.
{:paths ["source-code"]

 :deps
 {;; the server: http-kit, every request on a virtual thread; sse and ws built in
  http-kit/http-kit                 {:mvn/version "2.8.1"}
  ;; the routes: reitit on the server, reitit-frontend in the browser (ClojureScript sources)
  metosin/reitit-ring               {:mvn/version "0.11.0"}
  metosin/reitit-frontend           {:mvn/version "0.11.0"}
  ;; wire: data that crosses an edge comes back as what it was; the app makes
  ;; the wire and hands it in
  io.github.p4ulcristian/wire       {:git/tag "v0.2.0" :git/sha "d66b7cb"}
  ;; logbook: the app makes its log and hands it in; each message gets one that
  ;; knows its request id (the server's side only)
  io.github.p4ulcristian/logbook    {:git/tag "v0.1.1" :git/sha "51a2c93"}
  ;; meter: the app makes its meter and hands it in; mailroom declares its
  ;; metrics on it and counts each message and open line (the server's side only)
  io.github.p4ulcristian/meter      {:git/tag "v0.1.2" :git/sha "a0a977b"}
  ;; the settings, options, handlers and shapes, checked before anything runs
  metosin/malli                     {:mvn/version "0.20.3"}}

 :aliases
 {;; the JVM tests:  clojure -X:test
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}
  ;; the browser tests, through shadow-cljs:  npm install && npx shadow-cljs compile test
  :cljs {:extra-paths ["test-code"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}}}}}
