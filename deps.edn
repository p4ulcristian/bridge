;; bridge: named messages come in, a handler's steps answer them, the answers go out.
;; One tree for both languages: source-code/groundwork_bridge/, the server's .clj and the
;; browser's .cljs side by side.
{:paths ["source-code"]

 :deps
 {;; the server: Jetty 12 through rj9a (no servlet layer), every request on a
  ;; virtual thread; ws through Ring's websocket protocols, sse a streamed answer
  info.sunng/ring-jetty9-adapter    {:mvn/version "0.40.5"}
  ;; the routes: reitit on the server, reitit-frontend in the browser (ClojureScript sources)
  metosin/reitit-ring               {:mvn/version "0.11.0"}
  metosin/reitit-frontend           {:mvn/version "0.11.0"}
  ;; groundwork-shaped-json: data that crosses an edge comes back as what it was; the app makes
  ;; the shaper and hands it in
  io.github.p4ulcristian/groundwork-shaped-json       {:git/tag "v0.2.2" :git/sha "1c0fcf9"}
  ;; groundwork-logs: the app makes its log and hands it in; each message gets one that
  ;; knows its request id (the server's side only)
  io.github.p4ulcristian/groundwork-logs    {:git/tag "v0.1.3" :git/sha "8d1846e"}
  ;; groundwork-metrics: the app makes its meter and hands it in; bridge declares its
  ;; metrics on it and counts each message and open line (the server's side only)
  io.github.p4ulcristian/groundwork-metrics      {:git/tag "v0.1.5" :git/sha "1cffe8e"}
  ;; the settings, options, handlers and shapes, checked before anything runs
  metosin/malli                     {:mvn/version "0.20.3"}}

 :aliases
 {;; the JVM tests:  clojure -X:test
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}
  ;; the browser tests, through shadow-cljs:  npm install && npx shadow-cljs compile test
  :cljs {:extra-paths ["test-code"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}}}}}
